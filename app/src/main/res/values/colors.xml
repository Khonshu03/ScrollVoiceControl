<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background - neutral dark gray, not tinted. The color signal lives
         in the buttons/chips, not the backdrop. -->
    <color name="bg_top">#1C1C20</color>
    <color name="bg_bottom">#111113</color>

    <!-- Surfaces -->
    <color name="surface_card">#232327</color>
    <color name="surface_card_stroke">#34343A</color>
    <color name="surface_chip_unselected">#1D1D21</color>
    <color name="surface_chip_stroke">#333338</color>

    <!-- Brand purple - the Stop button / hero glow accent -->
    <color name="purple_100">#EDE9FE</color>
    <color name="purple_300">#C4B5FD</color>
    <color name="purple_400">#A78BFA</color>
    <color name="purple_500">#8B5CF6</color>
    <color name="purple_600">#7C3AED</color>
    <color name="purple_700">#6425D0</color>

    <!-- Mode colors - adopted from the Figma reference design, and matched
         1:1 with the overlay status-dot colors in OverlayService
         (MODE_COLORS), so the in-app card and the on-screen dot always
         agree on what color = which mode. Each mode is a two-hue gradient
         (light accent -> base -> a shifted second hue) rather than a single
         tint, e.g. voice runs pink into purple. -->
    <color name="mode_voice_light">#F472B6</color>
    <color name="mode_voice">#EC4899</color>
    <color name="mode_voice_dark">#A855F7</color>
    <color name="mode_voice_glow">#8CEC4899</color>

    <color name="mode_clap_light">#818CF8</color>
    <color name="mode_clap">#6366F1</color>
    <color name="mode_clap_dark">#8B5CF6</color>
    <color name="mode_clap_glow">#8C6366F1</color>

    <color name="mode_camera_light">#FB7185</color>
    <color name="mode_camera">#F43F5E</color>
    <color name="mode_camera_dark">#F97316</color>
    <color name="mode_camera_glow">#8CF43F5E</color>

    <!-- Text -->
    <color name="text_primary">#F5F5F7</color>
    <color name="text_secondary">#A3A3AC</color>
    <color name="text_muted">#6B6B74</color>

    <!-- Status -->
    <color name="status_on">#34D399</color>
    <color name="status_off">#4B4B54</color>
    <color name="status_on_glow">#5C34D399</color>
</resources>
