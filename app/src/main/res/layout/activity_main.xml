<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/space_grotesk"
            android:text="@string/app_name"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_surface"
            android:padding="18dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/statusDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/dot_off"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk"
                android:text="Voice control is OFF"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/space_grotesk"
            android:text="MODE"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/modeVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_voice"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Voice"
                android:textColor="@color/chip_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/modeClap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_clap"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Clap"
                android:textColor="@color/chip_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/modeCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_camera"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:checked="true"
                android:fontFamily="@font/space_grotesk"
                android:text="Camera"
                android:textColor="@color/chip_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RadioGroup>

        <!-- Glowing Stop button: real blurred halo (GlowView) behind a pill button -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp">

            <com.yhash.scrollvoice.GlowView
                android:layout_width="260dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                app:glowColor="@color/purple_500"
                app:glowBlurRadius="16dp"
                app:glowCornerRadius="28dp"
                app:glowShapeWidth="180dp"
                app:glowShapeHeight="56dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:minWidth="160dp"
                android:background="@drawable/btn_stop_selector"
                android:elevation="4dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/space_grotesk"
            android:lineSpacingExtra="5dp"
            android:text="@string/hint_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
