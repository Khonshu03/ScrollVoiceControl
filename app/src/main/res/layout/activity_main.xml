<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Master control card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:background="@drawable/card_surface" />

            <!-- Ambient corner glow, tinted to the active mode at runtime -->
            <com.yhash.scrollvoice.GlowView
                android:id="@+id/cardGlow"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:layout_gravity="end|top"
                android:alpha="0.35"
                app:glowColor="@color/purple_500"
                app:glowBlurRadius="20dp"
                app:glowCornerRadius="60dp"
                app:glowShapeWidth="90dp"
                app:glowShapeHeight="60dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="MASTER CONTROL"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:id="@+id/statusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/dot_off"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="Voice control is OFF"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/space_grotesk"
            android:text="DETECTION MODE"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="30dp">

            <RadioButton
                android:id="@+id/modeVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_voice"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/icon_badge_voice"
                android:drawablePadding="14dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Voice\nSpeak to scroll"
                android:textColor="@color/chip_text_selector"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <RadioButton
                android:id="@+id/modeClap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_clap"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/icon_badge_clap"
                android:drawablePadding="14dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Clap\n1 = down · 2 = up · 3 = back"
                android:textColor="@color/chip_text_selector"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <RadioButton
                android:id="@+id/modeCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:background="@drawable/chip_bg_selector_camera"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/icon_badge_camera"
                android:drawablePadding="14dp"
                android:checked="true"
                android:fontFamily="@font/space_grotesk"
                android:text="Camera\nWave your hand to scroll"
                android:textColor="@color/chip_text_selector"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

        </RadioGroup>

        <!-- Glowing Stop button: real blurred halo (GlowView) behind a pill button.
             Both are recolored at runtime in MainActivity.kt to match whichever
             mode is actually running. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.yhash.scrollvoice.GlowView
                android:id="@+id/stopGlow"
                android:layout_width="260dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                app:glowColor="@color/purple_500"
                app:glowBlurRadius="16dp"
                app:glowCornerRadius="28dp"
                app:glowShapeWidth="180dp"
                app:glowShapeHeight="56dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:minWidth="160dp"
                android:background="@drawable/btn_stop_selector"
                android:elevation="4dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:fontFamily="@font/space_grotesk"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/space_grotesk"
            android:lineSpacingExtra="5dp"
            android:text="@string/hint_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
