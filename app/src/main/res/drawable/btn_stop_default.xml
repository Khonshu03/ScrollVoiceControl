<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: rich 3-stop gradient (light top -> mid -> dark bottom) instead
         of a flat 2-tone fill, for a glassier, less flat-looking pill. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/purple_400"
                android:centerColor="@color/purple_500"
                android:endColor="@color/purple_700"
                android:type="linear" />
        </shape>
    </item>
    <!-- Gloss: soft translucent highlight band across the top third, like
         light catching the top of a glass/plastic pill. -->
    <item android:gravity="top|fill_horizontal" android:height="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/purple_300" />
        </shape>
    </item>
</layer-list>
