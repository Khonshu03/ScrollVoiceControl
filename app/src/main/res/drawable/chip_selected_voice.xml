<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/mode_voice_light"
                android:centerColor="@color/mode_voice"
                android:endColor="@color/mode_voice_dark"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/mode_voice_light" />
        </shape>
    </item>
</layer-list>
