<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/purple_500"
                android:centerColor="@color/purple_600"
                android:endColor="@color/purple_700"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/purple_400" />
        </shape>
    </item>
</layer-list>
